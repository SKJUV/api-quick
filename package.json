{
  "name": "@skjuve/api-quick",
  "version": "1.1.1",
  "description": "High-Performance Multi-Interface HTTP Engine, Automation & API Workbench",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "api-quick": "bin/api-quick.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "prepare": "husky || true",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "http",
    "api",
    "cli",
    "workbench",
    "rest",
    "graphql",
    "openapi",
    "postman",
    "httpie",
    "curl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKJUV/api-quick.git"
  },
  "author": "SKJUV",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
