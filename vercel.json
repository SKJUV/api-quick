{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "docs",
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/api-quick",
      "destination": "/index.html"
    },
    {
      "source": "/api-quick/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
